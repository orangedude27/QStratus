PORT=4000
FRONTEND_URL=http://localhost:3000

# Replace with a strong random value in production.
AUTH_SECRET=replace_me_with_a_long_random_secret

# Local persistence paths inside backend container.
DATA_FILE=/app/storage/store.json
SEED_GAMES_FILE=/app/data/games.json

# Shared secret used by stratusd when opening backend WebSocket API.
STRATUSD_PASSWORD=replace_me

# Restrict access if desired.
# WHITELISTED_DOMAIN=example.com
# WHITELISTED_USERS='["alice", "bob"]'

# Optional: enable Google OAuth login flow.
GOOGLE_CLIENT_ID=0123456789abcdef.apps.googleusercontent.com

# Steam library path for game discovery scanner
STEAM_LIBRARY_PATH=/data/steam/steamapps
