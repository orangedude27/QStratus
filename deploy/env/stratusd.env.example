# WebSocket API URL for coordination backend.
STRATUSD_BACKEND_URL=ws://localhost:4000
STRATUSD_BACKEND_PASSWORD=replace_me

# Public or LAN IP that browser clients should connect to.
STRATUSD_IP=127.0.0.1

# WebTransport UDP listener.
STRATUSD_PORT=4433

# Mounted read-only in compose at /games.
STRATUSD_GAME_DIR=/games

# Steam paths (for Steam games)
STRATUSD_STEAM_PATH=/data/steam/steamapps/common
STRATUSD_STEAM_PREFIX=/data/steam/userdata

# Proton version (default: latest, or specific like "9-11")
# PROTON_VERSION=latest

# Optional debug flags
# STRATUSD_API_DEBUG=1
# STRATUSD_CAPTURE_DEBUG=1
# STRATUSD_CAPTUREPW_DEBUG=1
# STRATUSD_ENCODE_DEBUG=1
# STRATUSD_INPUT_DEBUG=1
# STRATUSD_TRANSPORT_DEBUG=1

# Health check: pgrep -f stratusd (configured in docker-compose)
